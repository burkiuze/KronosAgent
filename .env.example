# Copy to ~/.kronos/.env (or use Settings → API Keys / `kronos keys set`). Only set what you use.
# With no keys at all Kronos runs an offline demo model.

# --- models -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
NOUS_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_HOST=http://127.0.0.1:1234

# --- tools ------------------------------------------------------------------------------
# web search (DuckDuckGo works without a key)
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8888
# images / voice
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
# used by MCP servers you configure, e.g. the GitHub MCP server
GITHUB_TOKEN=

# --- gateway & messaging ----------------------------------------------------------------
KRONOS_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
MATRIX_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
KRONOS_WEBHOOK_SECRET=
HASS_TOKEN=
SMTP_URL=
