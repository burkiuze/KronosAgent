{
  "name": "@kronos/desktop",
  "productName": "Kronos",
  "version": "1.0.1",
  "private": true,
  "description": "KRONOS Desktop — native shell for Kronos Agent.",
  "license": "Apache-2.0",
  "author": {
    "name": "Kronos Agent contributors",
    "email": "info@heynavio.com"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "ai.kronos.desktop",
    "productName": "Kronos",
    "executableName": "kronos",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "web/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kronos uses the microphone for voice input."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Kronos-${version}-${arch}.${ext}",
      "desktopName": "kronos.desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "burkiuze",
        "repo": "KronosAgent",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "*.png"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Kronos",
        "schemes": [
          "kronos"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kronos-Setup.${ext}"
    },
    "dmg": {
      "artifactName": "Kronos-mac.${ext}"
    },
    "deb": {
      "packageName": "kronos"
    }
  },
  "homepage": "https://heynavio.com/kronosagent"
}
