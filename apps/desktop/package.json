{
  "name": "@kronos/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "KRONOS Desktop — native shell for Kronos Agent.",
  "license": "Apache-2.0",
  "author": "Kronos Agent contributors",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "ai.kronos.desktop",
    "productName": "Kronos",
    "directories": { "output": "release" },
    "files": ["dist/**", "web/**", "skills/**", "package.json"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" },
    "publish": [{ "provider": "github", "owner": "burkiuze", "repo": "KronosAgent" }]
  }
}
